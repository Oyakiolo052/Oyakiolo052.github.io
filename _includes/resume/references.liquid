
<div class="list-groups">
  {% for content in data[1] %}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon"></td>
            {% endif %}

            <td class="list-group-category">
              <strong>{{ content.name }}</strong>
            </td>
          </tr>

          {% if content.reference and content.reference != '' %}
            <tr>
              <td></td>
              <td class="list-group-name">
                <div style="font-size: 0.9rem; line-height: 1.7; font-weight: normal;">
                  {{ content.reference }}
                </div>
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
