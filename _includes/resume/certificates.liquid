
<div class="list-groups">
  {% assign certificates = data[1] | sort: 'date' | reverse %}
  {% for content in certificates %}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon"></td>
            {% endif %}

            <td colspan="2" class="list-group-category">
              {% if content.url and content.url != '' %}
                <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">
                  <strong>{{ content.name }}</strong>
                </a>
              {% else %}
                <strong>{{ content.name }}</strong>
              {% endif %}
            </td>
          </tr>

          <!-- Issuing organization and date -->
          <tr>
            <td></td>
            <td class="list-group-name">
              <strong>{{ content.issuer }}</strong>
            </td>
            <td class="list-group-name" style="text-align: right; white-space: nowrap;">
              {% if content.date and content.date != '' %}
                {{ content.date | date: '%Y' }}
              {% endif %}
            </td>
          </tr>

          <!-- Certification summary -->
          {% if content.summary and content.summary != '' %}
            <tr>
              <td></td>
              <td colspan="2" class="list-group-name">
                <p style="margin-top: 5px; margin-bottom: 10px; font-size: 0.9rem; line-height: 1.6; font-weight: normal;">
                  {{ content.summary }}
                </p>
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
